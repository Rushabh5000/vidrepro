# Copy to .env — docker-compose reads this file.
VIDREPRO_ENV=dev
VIDREPRO_DATABASE_URL=postgresql+psycopg://vidrepro:vidrepro@postgres:5432/vidrepro
VIDREPRO_REDIS_URL=redis://redis:6379/0

VIDREPRO_S3_ENDPOINT=http://minio:9000
VIDREPRO_S3_PUBLIC_ENDPOINT=http://localhost:9000
VIDREPRO_S3_BUCKET=vidrepro
VIDREPRO_S3_ACCESS_KEY=minioadmin
VIDREPRO_S3_SECRET_KEY=minioadmin

VIDREPRO_JWT_SECRET=change-me-in-prod
VIDREPRO_DB_AUTO_CREATE=1

# Limits
VIDREPRO_MAX_UPLOAD_BYTES=2147483648
VIDREPRO_MAX_DURATION_S=2700

# OCR: tesseract (default, bundled in worker image) | paddle | none
VIDREPRO_OCR_ENGINE=tesseract

# AI is OFF by default — the pipeline is fully deterministic.
# Set to "anthropic" + key only if you want optional step-text refinement.
VIDREPRO_LLM_PROVIDER=none
VIDREPRO_ANTHROPIC_API_KEY=
VIDREPRO_LLM_MODEL=claude-sonnet-5

# Azure DevOps export (optional; can also be set per-org in org settings)
VIDREPRO_ADO_ORG=
VIDREPRO_ADO_PROJECT=
VIDREPRO_ADO_PAT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
